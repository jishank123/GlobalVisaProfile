# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/academic_erp
MONGODB_URI=mongodb+srv://intjatingupta_db_user:ngtsxyUqETB8QloH@cluster0.r0tzvox.mongodb.net/

# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/academic_erp?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Gmail Example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin User (Initial Setup)
ADMIN_EMAIL=admin@academic-erp.com
ADMIN_PASSWORD=Admin@123
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
